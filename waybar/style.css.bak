* {
    font-family: "JetBrainsMono Nerd Font", "Font Awesome 6 Free", sans-serif;
    font-size: 12px;
    font-weight: bold;
    min-height: 0;
}

label {
    font-weight: bold;
}

window#waybar {
    background-color: #121318;
    color: #cdd6f4;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition-property: background-color;
    transition-duration: 0.3s;
}

window#waybar.hidden {
    opacity: 0.2;
}

/* Reset default GTK button styles */
button {
    box-shadow: none;
    text-shadow: none;
    border: none;
    border-radius: 0;
    background: transparent;
}

/* ── Workspaces ── */
#workspaces {
    background: transparent;
    margin: 0;
    padding: 0;
}

#workspaces button {
    background-color: #262734;
    color: #a6adc8;
    border-radius: 12px;
    padding: 2px 10px;
    margin: 4px 3px;
    font-weight: 700;
    transition: all 0.2s ease;
}

#workspaces button:hover {
    background-color: #313244;
    color: #cdd6f4;
}

#workspaces button.focused,
#workspaces button.active {
    background-color: #89b4fa;
    color: #11111b;
    font-weight: 700;
}

#workspaces button.urgent {
    background-color: #f38ba8;
    color: #11111b;
    font-weight: 700;
}

/* ── Window Title (Center) ── */
#window {
    background: transparent;
    color: #cdd6f4;
    font-weight: bold;
    font-size: 12px;
    padding: 0 10px;
    margin: 4px 0;
}

/* ── Module Pills Base ── */
#idle_inhibitor,
#pulseaudio,
#network,
#power-profiles-daemon,
#cpu,
#memory,
#temperature,
#backlight,
#battery,
#clock.date,
#clock.time,
#tray,
#mode,
#scratchpad {
    background-color: #262734;
    border-radius: 12px;
    padding: 2px 10px;
    margin: 4px 3px;
    font-weight: bold;
    transition: all 0.2s ease;
}

/* ── Individual Module Colors ── */

/* Idle Inhibitor - Pink */
#idle_inhibitor {
    color: #f5c2e7;
    padding: 2px 8px;
}

/* Pulseaudio - Soft Blue */
#pulseaudio {
    color: #89b4fa;
}

#pulseaudio.muted {
    color: #f38ba8;
}

/* Network - Teal / Cyan */
#network {
    color: #94e2d5;
}

#network.disconnected {
    color: #f38ba8;
}

/* Power Profiles - Sapphire / Light Blue */
#power-profiles-daemon {
    color: #74c7ec;
    padding: 2px 8px;
}

/* CPU - Mint Green */
#cpu {
    color: #a6e3a1;
}

/* Memory - Lavender / Purple */
#memory {
    color: #cba6f7;
}

/* Temperature - Peach / Orange */
#temperature {
    color: #fab387;
}

#temperature.critical {
    color: #f38ba8;
}

/* Backlight - Warm Yellow */
#backlight {
    color: #f9e2af;
}

/* Battery - Light Green */
#battery {
    color: #a6e3a1;
}

#battery.charging,
#battery.plugged {
    color: #94e2d5;
}

#battery.warning:not(.charging) {
    color: #fab387;
}

#battery.critical:not(.charging) {
    color: #f38ba8;
    animation-name: blink;
    animation-duration: 0.8s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

@keyframes blink {
    to {
        background-color: #f38ba8;
        color: #11111b;
    }
}

/* Clock: Date & Time - Soft Periwinkle */
#clock.date,
#clock.time {
    color: #b4befe;
}

/* Tray */
#tray {
    padding: 2px 8px;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background-color: #f38ba8;
}

/* Sway Mode & Scratchpad */
#mode {
    color: #f9e2af;
}

#scratchpad {
    color: #fab387;
}

/* Tooltip */
tooltip {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 8px;
}

tooltip label {
    color: #cdd6f4;
}
